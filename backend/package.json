{
  "name": "amrutam-telemedicine-backend",
  "version": "1.0.0",
  "description": "Production-grade JavaScript backend for Amrutam Telemedicine System focusing on scalability, reliability, security, and observability",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --runInBand --coverage --detectOpenHandles --forceExit",
    "db:migrate": "node src/infrastructure/database/migrate.js",
    "db:seed": "node src/infrastructure/database/seed.js",
    "admin:sync": "node src/infrastructure/database/sync-admin.js"
  },
  "keywords": [
    "telemedicine",
    "amrutam",
    "healthcare",
    "nodejs",
    "javascript",
    "postgresql",
    "redis",
    "rest-api",
    "prometheus",
    "docker",
    "kubernetes"
  ],
  "author": "Amrutam Engineering Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "stripe": "^23.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "yamljs": "^0.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
